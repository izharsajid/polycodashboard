# Copy to .env for local work. Never commit a real value.
#
# On Netlify these are set as standard variables, not secrets, with scopes
# builds, functions and runtime, and context all. A variable marked secret does
# not reach a function at runtime in this setup. See AUTH-SPEC.md section 3.

# Needed only by scripts run from a laptop, such as scripts/seed-admin.ts.
# Inside a function Netlify injects them.
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# Resend, for invitation and password reset links.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_BASE_URL=

# The switch. Nothing is emailed unless this is exactly 'true'.
# Leave it empty until Izhar releases access. See AUTH-SPEC.md section 11.
EMAIL_SENDING_ENABLED=
